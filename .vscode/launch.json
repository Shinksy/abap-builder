{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "0"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}